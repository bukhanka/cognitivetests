{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_SKIP_TYPE_CHECKING=true NEXT_SKIP_LINT=true next build",
    "build-force": "NODE_OPTIONS=--no-warnings NEXT_SKIP_TYPE_CHECKING=true NEXT_SKIP_LINT=true next build --no-lint",
